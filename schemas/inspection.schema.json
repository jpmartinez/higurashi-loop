{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://higurashi-loop.invalid/schemas/inspection.schema.json",
  "title": "Higurashi inspection result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "kind"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "inspect"
    },
    "ok": {
      "type": "boolean"
    },
    "kind": {
      "type": "string",
      "enum": [
        "ready",
        "resume",
        "complete",
        "handoff_required",
        "repair_plan_required",
        "repair_ready",
        "repair_recovery_required",
        "invalid_repair_state",
        "unknown",
        "canceled",
        "invalid_artifact",
        "missing_requirement_source",
        "codegraph_unavailable",
        "codegraph_unhealthy",
        "configuration_missing",
        "configuration_invalid",
        "conflict",
        "not_git_project",
        "unsafe_project_root",
        "invalid_usage"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1
    },
    "workItemId": {
      "type": "string",
      "minLength": 1
    },
    "requirementSource": {
      "type": "string",
      "minLength": 1
    },
    "artifactPath": {
      "type": "string",
      "minLength": 1
    },
    "artifactStatus": {
      "type": "string",
      "enum": [
        "refined",
        "planned",
        "implementing",
        "verifying",
        "blocked",
        "complete"
      ]
    },
    "artifactHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blockedFrom": {
      "type": "string",
      "enum": [
        "refined",
        "planned",
        "implementing",
        "verifying"
      ]
    },
    "repairRound": {
      "type": "integer",
      "minimum": 0
    },
    "handoffPath": {
      "type": "string",
      "minLength": 1
    },
    "handoffValidation": {
      "type": "string",
      "enum": [
        "not_required",
        "missing",
        "invalid",
        "ready",
        "consumed"
      ]
    },
    "blockerCount": {
      "type": "integer",
      "minimum": 0
    },
    "authorizationRequired": {
      "type": "boolean"
    },
    "nextCommand": {
      "type": "string",
      "minLength": 1
    },
    "candidateStrategy": {
      "const": "uncommitted"
    },
    "progress": {
      "$ref": "#/$defs/progress"
    },
    "nextTask": {
      "$ref": "#/$defs/task"
    },
    "loop": {
      "$ref": "#/$defs/loop"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "codegraph": {
      "$ref": "#/$defs/codegraph"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "required": [
          "projectRoot",
          "workItemId",
          "requirementSource",
          "artifactPath",
          "progress",
          "loop",
          "codegraph"
        ],
        "properties": {
          "kind": {
            "enum": [
              "ready",
              "resume",
              "complete",
              "handoff_required",
              "repair_plan_required",
              "repair_ready",
              "repair_recovery_required",
              "invalid_repair_state"
            ]
          }
        }
      },
      "else": {
        "required": [
          "message"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "resume",
              "complete",
              "handoff_required",
              "repair_plan_required",
              "repair_ready",
              "repair_recovery_required",
              "invalid_repair_state"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "artifactStatus",
          "artifactHash"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "complete"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "artifactStatus": {
            "const": "complete"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "repair_plan_required"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "message",
          "repairRound",
          "handoffPath",
          "handoffValidation",
          "blockerCount",
          "authorizationRequired"
        ],
        "properties": {
          "handoffValidation": {
            "const": "ready"
          },
          "authorizationRequired": {
            "const": false
          }
        },
        "not": {
          "required": [
            "nextCommand"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "repair_ready"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "repairRound",
          "handoffPath",
          "handoffValidation",
          "blockerCount",
          "authorizationRequired",
          "nextCommand"
        ],
        "properties": {
          "handoffValidation": {
            "const": "ready"
          },
          "authorizationRequired": {
            "const": true
          }
        }
      }
    }
  ],
  "$defs": {
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "pending",
        "total"
      ],
      "properties": {
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxApplyBatchesPerRun",
        "maxRepairAttempts",
        "requireProgressAfterEveryBatch"
      ],
      "properties": {
        "maxApplyBatchesPerRun": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxRepairAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "requireProgressAfterEveryBatch": {
          "type": "boolean"
        }
      }
    },
    "codegraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "cliAvailable",
        "indexPresent",
        "statusHealthy",
        "rootMatches",
        "synchronization",
        "watcherState",
        "pendingChanges",
        "reindexRecommended"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "required",
            "preferred"
          ]
        },
        "cliAvailable": {
          "type": "boolean"
        },
        "indexPresent": {
          "type": "boolean"
        },
        "statusHealthy": {
          "type": "boolean"
        },
        "rootMatches": {
          "type": "boolean"
        },
        "synchronization": {
          "type": "string",
          "enum": [
            "unknown",
            "current",
            "stale"
          ]
        },
        "watcherState": {
          "const": "not_reported"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "indexState": {
          "type": "string",
          "minLength": 1
        },
        "pendingChanges": {
          "type": "integer",
          "minimum": 0
        },
        "reindexRecommended": {
          "type": "boolean"
        },
        "problem": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
